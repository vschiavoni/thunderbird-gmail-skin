{
  "name": "thunder-g-documentation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-docs": "python3 scripts/sync_docs.py",
    "prestart": "python3 scripts/sync_docs.py",
    "start": "bun --bun node_modules/@docusaurus/core/bin/docusaurus.mjs start",
    "prebuild": "python3 scripts/sync_docs.py",
    "build": "bun --bun node_modules/@docusaurus/core/bin/docusaurus.mjs build",
    "serve": "bun --bun node_modules/@docusaurus/core/bin/docusaurus.mjs serve",
    "clear": "bun --bun node_modules/@docusaurus/core/bin/docusaurus.mjs clear",
    "predev": "python3 scripts/sync_docs.py",
    "dev": "bun --bun node_modules/@docusaurus/core/bin/docusaurus.mjs start"
  },
  "dependencies": {
    "@docusaurus/core": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20.0"
  },
  "overrides": {
    "webpack": "5.99.9"
  }
}
