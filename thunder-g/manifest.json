{
  "manifest_version": 2,
  "name": "Thunder-G",
  "description": "__MSG_gmail_inspired_interface_for_thunderbird_with_native_ef84227__",
  "version": "0.22.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunder-g@vschiavoni",
      "strict_min_version": "153.0",
      "strict_max_version": "159.*",
      "update_url": "https://github.com/vschiavoni/thunderbird-gmail-skin/releases/latest/download/updates.json"
    }
  },
  "background": {
    "scripts": [
      "localization.js",
      "background.js"
    ]
  },
  "experiment_apis": {
    "inlineLabels": {
      "schema": "experiments/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "inlineLabels"
          ]
        ],
        "script": "experiments/api.js"
      }
    }
  },
  "icons": {
    "32": "icons/thunder-g-32.png",
    "64": "icons/thunder-g-64.png",
    "128": "icons/thunder-g-128.png"
  },
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "homepage_url": "https://github.com/vschiavoni/thunderbird-gmail-skin",
  "default_locale": "en"
}
